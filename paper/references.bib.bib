Web of Science ID: WOS:001541423300001},
	keywords = {generative artificial intelligence, TEACHERS, POLICY, edtech, commercialisation of education, Education influencers, LEADERS, teacher workload, VISIBILITY},
}

@article{fareed_introducing_2025,
