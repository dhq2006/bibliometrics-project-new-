Web of Science ID: WOS:001447166300001},
	keywords = {generative artificial intelligence, teacher education, artificial intelligence in education, AI and emotional intelligence, educational technology teaching, ethical AI in education, human-centered AI, METAANALYSIS, METHODOLOGY, Social-Emotional Learning (SEL)},
	pages = {312--328},
}

