@article{karayianni_between_2026,
	address = {Cham},
	title = {Between a {Bot} and a {Hard} {Place}: {Student} {Engagement}, {Technology} {Anxiety} and {ChatGPT} {Trust} in {Higher} {Education}},
	volume = {70},
	issn = {8756-3894, 1559-7075},
	doi = {10.1007/s11528-025-01124-7},
	abstract = {While studies have explored factors influencing ChatGPT's adoption and impact in Higher Education (HE), they have not yet considered how student engagement, technology anxiety, attitudes toward AI, and trust interact-key elements shaping students' effective usage of AI tools. To address this gap, we surveyed a nationwide sample of 422 Greek HE students of various disciplines who completed the Short Utrecht Work Engagement Scale-Student Form, the Abbreviated Technology Anxiety Scale, the ChatGPT Trust Scale, and measures of academic usage and attitudes. Student engagement was positively associated with AI attitudes, ChatGPT trust, and usage frequency. Nonusers reported higher technology anxiety than users, and anxiety was negatively related to AI attitudes while moderating the relationship between trust and usage. Trust predicted usage, perceived usefulness, and engagement. Cluster analysis identified two user typologies: high-engagement users, who reported greater trust, confidence, and diverse academic ChatGPT applications, and low-engagement users, who exhibited lower ChatGPT reliance and received less institutional guidance on AI. The findings point to the need for institutional AI literacy initiatives and structured support.},
	language = {English},
	number = {1},
	journal = {TECHTRENDS},
	publisher = {Springer Int Publ Ag},
	author = {Karayianni, I. and Klidas, A. and Karakitsou, C.},
	month = feb,
	year = {2026},
	note = {Num Pages: 18
Web of Science ID: WOS:001532554300001},
	keywords = {GenAI, ADOPTION, Higher education, IMPACT, Educational technology, MOTIVATION, Student engagement, ChatGPT trust, Technology anxiety, TECHNOSTRESS},
	pages = {39--56},
}

@article{ren_errors_2025,
	address = {Abingdon},
	title = {From errors to excellence: {AI}-driven scaffolding for advancing {L2} writing skills},
	volume = {12},
	issn = {2331-186X},
	doi = {10.1080/2331186X.2025.2588512},
	abstract = {This study leveraged large language models' (LLMs) function of mimicking students' particular errors and generating essays that embed those errors, thereby yielding targeted revision exercises. This research examined how AI-generated feedback and the subsequent error correction exercises influenced undergraduates' academic writing in an eight-week academic writing course in mainland China, also probing the mediating role of proficiency levels. A convenience sample of 44 English-majors was allocated to an experimental group (n = 25) that received dual interventions tailored to each learner's recurrent writing problems, or a comparison group (n = 19) that received AI-generated feedback only. Subsequently, a purposive sub-sample of 12 participants was selected for online semi-structured interviews for qualitative insights. The quantitative analysis revealed significant improvements in both groups' writing after the intervention, with proficiency level moderating the outcomes. Crucially, the experimental group significantly outperformed their comparison counterparts in mid-test. By deploying GPT-4o to simulate students' recurrent writing errors and generate targeted correction materials, this study informs pedagogy on how LLMs scaffold personalized learning environments, enabling differentiated instruction tailored to the proficiency continuum in academic writing courses.},
	language = {English},
	number = {1},
	journal = {COGENT EDUCATION},
	publisher = {Taylor \& Francis Ltd},
	author = {Ren, Boyuan and Dong, Yanyun and Zhang, Boxuan},
	month = dec,
	year = {2025},
	note = {Num Pages: 15
Web of Science ID: WOS:001618425000001},
	keywords = {higher education, Generative AI, L2 writing, mixed method, self-correction},
	pages = {2588512},
}

@article{selwyn_role_2025,
	address = {Abingdon},
	title = {The role of '{AI} advocate' teachers in mediating technological change across {Australian} schools},
	issn = {1354-0602, 1470-1278},
	doi = {10.1080/13540602.2025.2596832},
	abstract = {The recent promotion of artificial intelligence (AI) across education systems has seen growing numbers of teachers taking on roles as unofficial ed-tech intermediaries and advocating, advising and generally championing the cause of this technology use within schools. This paper examines the role of teachers with public profiles as 'AI advocates' in promoting the take-up of artificial intelligence technology within Australian high schools following the emergence of Chat GPT and other generative AI. Drawing on interview data with 14 such teachers, the paper highlights the roles that these teachers play in engaging (and often perpetuating) popular educational hype around AI while often struggling to secure widespread take-up within their own schools. These findings point to new forms of teacher professionalisation arising from public-facing expertise around emerging technology-with these teachers directing much of their efforts (and finding most reward) outside of their own schools through engagement in social media networks, conference speaking, book publishing and other external forums. This raises questions over the vulnerabilities faced by teachers engaging in such work, as well as how the take-up of AI might be better facilitated within schools.},
	language = {English},
	journal = {TEACHERS AND TEACHING},
	publisher = {Routledge Journals, Taylor \& Francis Ltd},
	author = {Selwyn, Neil and Szili, Adriana},
	month = nov,
