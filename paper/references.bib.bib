Web of Science ID: WOS:001620856500001},
	keywords = {generative AI, EDUCATION, IMPACT, critical thinking, CHALLENGES, GENERATION, FEEDBACK, EXAMPLES, BIAS, COGNITIVE-SCIENCE, Contract law, errorful learning, legal education},
	pages = {833--868},
}

