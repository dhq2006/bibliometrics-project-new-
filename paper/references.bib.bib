	keywords = {ChatGPT, CHATGPT, ACCEPTANCE, Chatbots, Artificial Intelligence, EASE, Ethical \& Social Aspects of IT, Information \& Communication Technology (ICT), Middle School Education, middle school teachers, perceived credibility, perceived usability, Primary/Elementary Education, Secondary Education},
