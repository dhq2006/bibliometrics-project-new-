Web of Science ID: WOS:001463233200001},
	keywords = {ARTIFICIAL-INTELLIGENCE, GenAI, HIGHER-EDUCATION, INFORMATION, ACADEMIC INTEGRITY, AI summariser, higher education students, text summariser, unit readings},
	pages = {1655--1668},
}

