	note = {Num Pages: 12
Web of Science ID: WOS:001082780300001},
	keywords = {higher education, ChatGPT, artificial intelligence, EDUCATION, assessment writing, Authentic assessment, case studies},
	pages = {2473--2484},
}

@article{karppinen_reviewing_2025,
	address = {University Pk},
	title = {Reviewing the {Debate} on the {Implications} of {Generative} {AI} for {Democracy}},
