	issn = {2196-7091},
	doi = {10.1186/s40561-024-00350-5},
	abstract = {Despite the increased adoption of Artificial Intelligence in Education (AIED), several concerns are still associated with it. This has motivated researchers to conduct (systematic) reviews aiming at synthesizing the AIED findings in the literature. However, these AIED reviews are diversified in terms of focus, stakeholders, educational level and region, and so on. This has made the understanding of the overall landscape of AIED challenging. To address this research gap, this study proceeds one step forward by systematically meta-synthesizing the AIED literature reviews. Specifically, 143 literature reviews were included and analyzed according to the technology-based learning model. It is worth noting that most of the AIED research has been from China and the U.S. Additionally, when discussing AIED, strong focus was on higher education, where less attention is paid to special education. The results also reveal that AI is used mostly to support teachers and students in education with less focus on other educational stakeholders (e.g. school leaders or administrators). The study provides a possible roadmap for future research agenda on AIED, facilitating the implementation of effective and safe AIED.},
	language = {English},
	number = {1},
	journal = {SMART LEARNING ENVIRONMENTS},
	publisher = {Springer Heidelberg},
	author = {Mustafa, Muhammad Yasir and Tlili, Ahmed and Lampropoulos, Georgios and Huang, Ronghuai and Jandric, Petar and Zhao, Jialu and Salha, Soheil and Xu, Lin and Panda, Santosh and Kinshuk, Sonsoles and Lopez-Pernas, Sonsoles and Saqr, Mohammed},
	month = dec,
	year = {2024},
	note = {Num Pages: 33
Web of Science ID: WOS:001372880900001},
	keywords = {Generative AI, Artificial intelligence, Education, Literature review, CLASSROOM, Smart learning, Future research, Meta-synthesis, RESEARCH TRENDS, TECHNOLOGIES, TUTORING SYSTEMS},
	pages = {59},
}

@article{peng_supporting_2025,
	address = {Abingdon},
	title = {Supporting transnational teaching in {Finnish} education export: {Possibilities} and limitations of using {ChatGPT} as a virtual assistant during short-term teaching abroad},
	volume = {62},
	issn = {1470-3297, 1470-3300},
	doi = {10.1080/14703297.2024.2413053},
	abstract = {The purpose of this opinion piece is to explore the potential of ChatGPT as a virtual assistant for transnational educators in the context of Finnish education export. It examines the possibilities and limitations of utilising ChatGPT to support short-term teaching assignments abroad. Utilising Su and Yang's (2023) framework for using ChatGPT in education, it is argued that the cultural-linguistic, pedagogical, and practical support provided by ChatGPT can be highly effective and personalised, particularly in instances where it is difficult to offer timely support for short-term teaching abroad. However, it is recommended that users should exercise caution in evaluating the effectiveness of ChatGPT in achieving expected outcomes, consider the limitations of its capacity to generate accurate information and correct responses, and address ethical and legal considerations.},
