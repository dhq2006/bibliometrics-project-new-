Web of Science ID: WOS:001487480500001},
	keywords = {generative AI, VARIABLES, public relations, responsible AI, trust, Corporate data responsibility, ETHICS, privacy, stakeholder engagement, VARIANCE},
	pages = {447--469},
}

@article{turmuzi_chatgpt_2026,
	address = {Oxford},
	title = {{ChatGPT} in school mathematics education: {A} systematic review of opportunities, challenges, and pedagogical implications},
	volume = {170},
	issn = {0742-051X, 1879-2480},
	doi = {10.1016/j.tate.2025.105286},
	abstract = {This PRISMA-based systematic review analyzes 20 empirical studies (2023-2025) on ChatGPT in mathematics education. Findings show that 65\% employed qualitative (mixed methods), focusing on user perceptions. Key results reveal: (1) ChatGPT effectively provides instant feedback (70\% of studies) and personalized support, especially in algebra/statistics; (2) limitations in complex problem-solving (e.g., calculus) and student overreliance (40\% of studies). Ethical concerns like academic integrity and AI literacy gaps were identified. The study emphasizes structured teacher guidance and hybrid models to balance AI's benefits and risks, advocating policy frameworks for educational integration and further research on long-term impacts.},
	language = {English},
