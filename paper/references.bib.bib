@article{arowosegbe_perception_2024,
	address = {Lausanne},
	title = {Perception of generative {AI} use in {UK} higher education},
	volume = {9},
	issn = {2504-284X},
	doi = {10.3389/feduc.2024.1463208},
	abstract = {Background Generative artificial intelligence (Gen-AI) has emerged as a transformative tool in research and education. However, there is a mixed perception about its use. This study assessed the use, perception, prospect, and challenges of Gen-AI use in higher education. Methods This is a prospective, cross-sectional survey of university students in the United Kingdom (UK) distributed online between January and April 2024. Demography of participants and their perception of Gen-AI and other AI tools were collected and statistically analyzed to assess the difference in perception between various subgroups. Results A total of 136 students responded to the survey of which 59\% (80) were male. The majority were aware of Gen-AI and other AI use in academia (61\%) with 52\% having personal experience of the tools. Grammar correction and idea generation were the two most common tasks of use, with 37\% being regular users. Fifty-six percent of respondents agreed that AI gives an academic edge with 40\% holding a positive overall perception about the use in academia. Comparatively, there was a statistically significant difference in overall perception between different age ranges (I-2 = 27.39; p = 0.002) and levels of education (I-2 = 20.07; p {\textless} 0.001). Also, 83\% of students believe AI use will increase in academia with over half agreeing it should be integrated into learning. Plagiarism (33\%), privacy issues (14\%), and lack of clarity by the university (13\%) remain the top concerns regarding the use of Gen-AI and other AI tools in academia. Conclusion Gen-AI and other AI tools are being used and their use will continue to grow in higher education. While current use is challenging due mainly to plagiarism fear and lack of clarity by the university, most users believe AI should be integrated into the university curriculum.},
	language = {English},
	journal = {FRONTIERS IN EDUCATION},
	publisher = {Frontiers Media Sa},
	author = {Arowosegbe, Abayomi and Alqahtani, Jaber S. and Oyelade, Tope},
	month = oct,
	year = {2024},
	note = {Num Pages: 11
Web of Science ID: WOS:001335124400001},
	keywords = {higher education, ARTIFICIAL-INTELLIGENCE, HEALTH, artificial intelligence, generative AI, pedagogy, machine learning, APPS, RESPONSE RATES, SMARTPHONE APPLICATIONS},
	pages = {1463208},
}

