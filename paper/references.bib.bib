Web of Science ID: WOS:001652672600004},
	keywords = {ChatGPT, DESIGN, Critical thinking, Reflective thinking, Large language models, PARTICIPATION, Creative thinking, CREATIVE-THINKING, Undergraduate students, VALUES},
	pages = {100198},
}

