@article{xia_needs_2025,
	address = {Hoboken},
	title = {Needs {Satisfaction} {Mediates} the {Relationships} {Between} {TPACK}, {Self}-{Efficacy} and {Teachers}' {Willingness} to {Integrate} {Generative} {AI} {Into} {Higher} {Education} {Practices}},
	volume = {60},
	issn = {0141-8211, 1465-3435},
	doi = {10.1111/ejed.70328},
	abstract = {The success of efforts to integrate generative AI (GenAI) into classrooms depends heavily on teachers' willingness to integrate the relevant technologies. However, few studies have examined the effect of perceived psychological needs satisfaction on teachers' willingness to integrate GenAI (WIAI). This study investigated the effect of perceived needs satisfaction according to self-determination theory (SDT) on the relationships between technological pedagogical content knowledge (TPACK), self-efficacy (SE) and WIAI among college teachers. Specifically, 1348 college teachers completed a comprehensive survey on the interconnectedness of TPACK, SE and SDT needs (autonomy, competence and relatedness) and their effects on WIAI. Structural equation modelling revealed that perceived SDT needs and SE directly affected WIAI. TPACK and SE significantly affected perceived SDT needs. The perceived SDT needs mediated the relationships of TPACK and SE with WIAI. These findings contribute to the literature of SDT, and provide practical recommendations for college administrators, tool developers and education researchers.},
	language = {English},
	number = {4},
	journal = {EUROPEAN JOURNAL OF EDUCATION},
	publisher = {Wiley},
