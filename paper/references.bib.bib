@article{lee_generative_2025,
	address = {Cambridge},
	title = {Generative {AI} and {English} language teaching: {A} global {Englishes} perspective},
	volume = {45},
	issn = {0267-1905, 1471-6356},
	doi = {10.1017/S0267190525100184},
	abstract = {Generative AI (GenAI) offers potential for English language teaching (ELT), but it has pedagogical limitations in multilingual contexts, often generating standard English forms rather than reflecting the pluralistic usage that represents diverse sociolinguistic realities. In response to mixed results in existing research, this study examines how ChatGPT, a text-based generative AI tool powered by a large language model (LLM), is used in ELT from a Global Englishes (GE) perspective. Using the Design and Development Research approach, we tested three ChatGPT models: Basic (single-step prompts); Refined 1 (multi-step prompting); and Refined 2 (GE-oriented corpora with advanced prompt engineering). Thematic analysis showed that Refined Model 1 provided limited improvements over Basic Model, while Refined Model 2 demonstrated significant gains, offering additional affordances in GE-informed evaluation and ELF communication, despite some limitations (e.g., defaulting to NES norms and lacking tailored GE feedback). The findings highlight the importance of using authentic data to enhance the contextual relevance of GenAI outputs for GE language teaching (GELT). Pedagogical implications include GenAI-teacher collaboration, teacher professional development, and educators' agentive role in orchestrating diverse resources alongside GenAI.},
	language = {English},
	journal = {ANNUAL REVIEW OF APPLIED LINGUISTICS},
	publisher = {Cambridge Univ Press},
	author = {Lee, Seongyong and Jeon, Jaeho and McKinley, Jim and Rose, Heath},
	month = mar,
	year = {2025},
	note = {Num Pages: 24
Web of Science ID: WOS:001566488000001},
	keywords = {generative AI, GenAI, English language teaching, global Englishes, teacher agency},
	pages = {85--108},
}

@article{sui_who_2025,
	address = {New York},
	title = {Who will benefit from {AIGC}: {An} empirical study on the intentions to use artificial intelligence generated content in higher education},
	volume = {30},
	issn = {1360-2357, 1573-7608},
	doi = {10.1007/s10639-025-13590-w},
	abstract = {This study explores the role of Artificial Intelligence Generated Content (AIGC) in undergraduates' learning and research, and its increasing significance in higher education. Against this backdrop, understanding college students' attitudes, behaviors, and intentions towards AIGC is beneficial for better guiding their learning under the support of intelligent technology for high-quality development. Therefore, based on the Theory of Planned Behavior, this paper randomly sampled 336 Chinese undergraduates and conducted a survey. The results revealed that: (1) Undergraduates overall hold a positive attitude towards AIGC technology, perceive behavioral control, and intend to use it, yet some students feel less supported by peers and their institutions. (2) For the users group, attitudes towards AIGC technology, subjective norms, and perceived behavioral control each have a directly significant positive impact on the intention to use AIGC technology. Attitude and subjective norms are the two strongest predictors of the intention to use AIGC technology. (3) For the non-users group, attitudes towards AIGC technology and subjective norms only influence behavioral intentions through perceived behavioral control, which shows a significant full mediating effect between attitudes towards AIGC technology and behavioral intentions, as well as between subjective norms and behavioral intentions. The study provides valuable insights for enhancing undergraduates' application of AIGC technology.},
	language = {English},
	number = {14},
	journal = {EDUCATION AND INFORMATION TECHNOLOGIES},
	publisher = {Springer},
	author = {Sui, Xinrui and Lin, Qicong and Wang, Qi and Wan, Haipeng},
	month = sep,
	year = {2025},
	note = {Num Pages: 25
Web of Science ID: WOS:001480136200001},
	keywords = {AIGC, ATTITUDES, BEHAVIOR, Intention to Use, Theory of Planned Behavior, Undergraduates},
	pages = {20627--20651},
}

@article{bozkurt_genai_2024,
