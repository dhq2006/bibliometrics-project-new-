Web of Science ID: WOS:001497043900004},
	keywords = {Experiential learning cycle, Generative artificial intelligence (GAI), Multimodal learning portfolio, Pedagogical AI agent, Process-outcome-balanced educational practice},
	pages = {347--385},
}

@article{durak_are_2024,
	address = {Eskisehir},
	title = {{ARE} {ALARM} {BELLS} {RINGING} {IN} {ACADEMIA}? {CHATGPT} {AS} {A} {SAMPLE} {OF} {USING} {CHATBOTS} {IN} {EDUCATION}},
	volume = {25},
	issn = {1302-6488},
	doi = {10.17718/tojde.1353737},
	abstract = {The main aim of this mixed methods study is to determine the evaluations made by academics on an academic text generated with ChatGPT and get their general views on ChatGPT. The convergent parallel design is utilized where the qualitative and quantitative methods are combined to produce triangulated results. Data were collected via an online form from 45 academics. Academics were asked to read and rate the sample text generated by ChatGPT. The titles "Writing rules," "Language and expression," and "Subject integrity" of the text generated by ChatGPT received the highest ratings from the academics. The qualitative findings obtained were interpreted within the framework of the "Diffusion of Innovations" and "Uses and Gratifications" theories, and the related themes were formed. As a result, the participants were asked about their feelings about using ChatGPT, and the themes of astonishment, pessimism, anxiety, and hopefulness emerged. Participants were asked their opinions about the benefits and negative aspects of using ChatGPT. Themes emerged under the benefits, and negative aspects titles were evaluated. Finally, the other themes that emerged under the satisfaction with ChatGPT and making ChatGPT widespread titles were assessed.},
	language = {English},
	number = {3},
	journal = {TURKISH ONLINE JOURNAL OF DISTANCE EDUCATION},
	publisher = {Anadolu Univ},
	author = {Durak, Gurhan and Cankaya, Serkan},
	month = jul,
	year = {2024},
	note = {Num Pages: 17
Web of Science ID: WOS:001265263000001},
	keywords = {ChatGPT, Generative AI, Artificial intelligence, Chatbots in Education, Diffusion of Innovations},
	pages = {1353737},
}

@article{he_ai-generated_2026,
	address = {Abingdon},
	title = {{AI}-generated content and academic norms: perspectives and reflections of college students},
	volume = {34},
	issn = {1049-4820, 1744-5191},
	doi = {10.1080/10494820.2025.2511252},
	abstract = {Generative AI tools, such as ChatGPT, are transforming education and sparking debates surrounding academic integrity. We surveyed college students from diverse cultural backgrounds to explore the ethical implications of AI in academic settings. This analysis included a review of international cases and relevant literature. The survey revealed a range of student perspectives: some view AI-generated content as fair use, while others express concerns that it may encourage plagiarism and undermine critical thinking. Students also shared varied opinions on the regulation of AI use and the importance of fostering awareness of academic integrity. The emergence of ChatGPT has also presented challenges for educators in their teaching efforts. Our study provides data to enhance the understanding of plagiarism and assist in establishing academic norms. Based on the survey results, we propose measures to promote regulatory policies and teaching adjustments, as well as to develop standardized guidelines for AI use. Our goal is to establish comprehensive norms for the responsible and effective application of AI in higher education.},
	language = {English},
	number = {3},
	journal = {INTERACTIVE LEARNING ENVIRONMENTS},
	publisher = {Routledge Journals, Taylor \& Francis Ltd},
	author = {He, Qimeng and You, Xianwen and Shen, Jie},
	month = mar,
	year = {2026},
	note = {Num Pages: 15
Web of Science ID: WOS:001501348000001},
	keywords = {ChatGPT, academic integrity, Artificial intelligence, ethics, AGE, college students},
	pages = {1006--1020},
}

@article{shata_artificial_2025,
	address = {New York},
	title = {Artificial intelligence and communication technologies in academia: faculty perceptions and the adoption of generative {AI}},
	volume = {22},
	issn = {2365-9440},
	doi = {10.1186/s41239-025-00511-7},
	abstract = {Artificial intelligence (AI) is ushering in an era of potential transformation in various fields, especially in educational communication technologies, with tools like ChatGPT and other generative AI (GenAI) applications. This rapid proliferation and adoption of GenAI tools have sparked significant interest and concern among college professors, who are dealing with evolving dynamics in digital communication within the classroom. Yet, the effect and implications of GenAI in education remain understudied. Therefore, this study employs the Technology Acceptance Model (TAM) and the Social Cognitive Theory (SCT) as theoretical frameworks to explore higher education faculty's perceptions, attitudes, usage, and motivations, as the underlying factors that influence their adoption or rejection of GenAI tools. A survey was conducted among full-time higher education faculty members (N = 294) recruited from two mid-size public universities in the US. Results found that college professors' perceived usefulness of AI predicted their attitudes and intention to use and adopt the technology, more than their perceived ease of use. Trust and social reinforcement strongly influenced college professors' GenAI adoption decisions and acted as significant mediators to better understand the relationship between TAM and SCT. Findings emphasized the power of social dynamics in shaping professors' self-efficacy, attitudes, and use of GenAI. Trust enhances peer influence and affects how perceived usefulness shapes users' willingness to adopt technology, whereas self-efficacy has a minimal impact. This research provides valuable insights that inform higher education policies aimed at improving the educational experience for college students in an AI-driven workforce.},
	language = {English},
	number = {1},
	journal = {INTERNATIONAL JOURNAL OF EDUCATIONAL TECHNOLOGY IN HIGHER EDUCATION},
	publisher = {Springer},
	author = {Shata, Aya and Hartley, Kendall},
	month = mar,
	year = {2025},
	note = {Num Pages: 22
Web of Science ID: WOS:001467500300001},
	keywords = {Artificial intelligence, USER ACCEPTANCE, Higher education, IMPACT, Faculty, Self-efficacy, Communication technology, INFORMATION, SOCIAL COGNITIVE THEORY, Social influence, Technology adoption, Trust, TRUST},
	pages = {14},
}

@article{tongchai_thai_2026,
	address = {Cham},
	title = {Thai {Teachers}'{Perceptions} of {Integrating} {Generative} {AI} in {K}-12 {Education}: {Opportunities} and {Challenges}},
	volume = {70},
	issn = {8756-3894, 1559-7075},
	doi = {10.1007/s11528-025-01128-3},
	abstract = {This study investigates Thai K-12 teachers' perceptions of integrating Generative AI (GAI) into educational practices, focusing on its benefits, challenges, and adoption factors. Employing a survey design with a mixed-methods approach, a sample of 416 teachers was surveyed, and thematic analysis of open-ended responses was conducted. Exploratory Factor Analysis (EFA) identified two key dimensions: Advantages, including enhancing teaching efficiency and supporting personalized learning, and Challenges, such as ethical concerns and the impact on critical thinking. Qualitative findings revealed that teachers view GAI as a valuable tool for improving teaching efficiency and engagement while easing workload, but they raised concerns about its potential to undermine critical thinking and highlighted challenges like inadequate infrastructure and the need for ethical guidelines. The EFA model demonstrated good fit indices with RMSEA = .089, SRMR = .023, TLI = .952, and CFI = .975. Quantitative analysis revealed a strong relationship with a large effect size between self-efficacy and GAI adoption (r = .68, p {\textless} .001, z = .83). Disparities in access to technology further emphasize the need for equitable solutions to ensure all educators can effectively integrate GAI. These findings emphasize the importance of professional development, ethical guidelines, and resource equity to ensure effective and responsible GAI integration. The study provides actionable insights for advancing AI adoption in education.},
	language = {English},
	number = {1},
	journal = {TECHTRENDS},
	publisher = {Springer Int Publ Ag},
	author = {Tongchai, Apisit and Malakul, Sivakorn},
	month = feb,
	year = {2026},
	note = {Num Pages: 13
Web of Science ID: WOS:001565469200001},
	keywords = {Generative AI, Educational technology, AI in education, AI Generated Content (AIGC), Teacher perceptions},
	pages = {93--105},
}

