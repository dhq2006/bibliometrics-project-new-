Web of Science ID: WOS:001515229900001},
	keywords = {generative AI (GenAI), human-AI collaboration, AI art, AI and creativity, Anna Ridler, artistic innovation, ethical implications of AI art, MACHINE, MIND, modernism, Refik Anadol, social impact of AI art, transparency in AI art},
	pages = {52},
}

@article{forte_exploring_2025,
