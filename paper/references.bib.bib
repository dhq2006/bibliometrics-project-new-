Web of Science ID: WOS:001630443100007},
	keywords = {ChatGPT, SCIENCE, Higher education, MODEL, SKILLS, EFL, EXPERIENCES, ENVIRONMENT, CHATBOT, CONTEXT, CONVERSATIONAL AGENT, English speaking proficiency, Learning interest},
}

