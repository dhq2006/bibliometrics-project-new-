}

@article{rana_generative_2025,
	address = {Launceston},
	title = {Generative {AI} in {Design} {Thinking} {Pedagogy}: {Enhancing} {Creativity}, {Critical} {Thinking}, and {Ethical} {Reasoning} in {Higher} {Education}},
	volume = {22},
	issn = {1449-9789},
	doi = {10.53761/tjse2f36},
	abstract = {This study investigates how generative AI (GenAI) integration within Design Thinking pedagogy transforms undergraduate students' creativity, critical thinking, and ethical reasoning. Using mixed methods analysis of 112 student reflections from a 12-week course, we examined experiences with GenAI tools such as ChatGPT and DALL{\textless}middle dot{\textgreater}E across Design Thinking's five stages. Thematic analysis revealed four key themes: Perceived Benefits (enhanced creativity and accessibility), Ethical Concerns (bias and authorship ambiguity), Hesitance \& Acceptance (evolution from scepticism to strategic adoption), and Critical Validation (development of epistemic vigilance). Sentiment analysis showed 86\% positive responses, though ethical concerns generated significant negative sentiment (62\%). Findings demonstrate that GenAI, when pedagogically scaffolded, augments rather than replaces human judgment. Students evolved from passive users to critical evaluators, developing strategies for bias detection and source validation. The study challenges traditional cognitive taxonomies and calls for reimagining AI literacy as a multidimensional competence encompassing creativity, ethics, and critical reasoning essential for navigating AI-mediated learning environments. Practitioner Notes 1. Educators should treat GenAI as a co-creator in the learning process, not just a productivity tool, to support deeper student engagement. 2. Critical thinking with GenAI requires teaching students to evaluate, question, and verify outputs rather than passively accept them. 3. Embedding GenAI in Design Thinking pedagogy can enhance creativity and ethical reasoning when scaffolded with reflective and team-based learning. 4. AI tools must be introduced with discussions on algorithmic bias and ownership to prevent ethical blind spots in student learning. 5. Faculty development should focus on equipping educators to design GenAI-integrated learning environments that promote agency, not automation.},
	language = {English},
	number = {4},
	journal = {JOURNAL OF UNIVERSITY TEACHING AND LEARNING PRACTICE},
	publisher = {Open Access Publishing Assoc},
	author = {Rana, Vishal and Verhoeven, Bert and Sharma, Madhav},
	year = {2025},
	note = {Num Pages: 22
Web of Science ID: WOS:001569150500014},
	keywords = {Constructivist Learning Theory, Creativity and Critical Thinking, Design Thinking Pedagogy, Ethical Reasoning, Generative Artificial Intelligence (GenAI)},
	pages = {36},
}

@article{gottschling_persuasive_2025,
	address = {New York},
	title = {Persuasive {Surfaces} and {Calculating} {Machines}. {A} {Rhetorical} {Perspective} on {Artificial} {Intelligence}},
	volume = {35},
	issn = {2948-152X, 2948-1538},
	doi = {10.1007/s10516-025-09748-3},
	abstract = {This essay examines the communicative implications of generative AI through a rhetorical lens. Rather than asking whether machines can truly 'think,' this approach considers how generative AI's probabilistic outputs construct persuasive textual 'surfaces' that interact rhetorically with human communication. Authorship and meaning are no longer localized to a single individual creator but emerge through the interplay of human and machine co-construction of 'possible worlds.' By viewing generative AI as a 'techn \& eacute;' in the classical sense, we examine how models 'imitate' prior texts through algorithmic recombination. As AI accelerates information flows, it becomes increasingly important for individuals to develop rhetorical literacy, to deconstruct the interests and values encoded in AI's persuasive surfaces. In contrast to the influential but one-directional information-theoretical communication model proposed by Shannon (1948), the essay advocates a rhetorical model of communication that emphasizes the active role of readers in reconstructing possible worlds from textual offers. Rather than neutral vessels of truth, generative AI outputs are inherently contingent yet interest-driven, requiring enhanced communicative competencies to navigate their impacts on changing concepts of reality, authorship, and common ground.},
	language = {English},
	number = {3},
	journal = {GLOBAL PHILOSOPHY},
	publisher = {Springer},
	author = {Gottschling, Markus and Kramer, Olaf},
	month = may,
	year = {2025},
	note = {Num Pages: 22
Web of Science ID: WOS:001485441100001},
	keywords = {Generative AI, Anthropomorphism, Communication, Persuasion, Rhetoric},
	pages = {15},
}

@article{tafazoli_exploring_2025,
	address = {Moscow},
	title = {Exploring the {Affordances} of {ChatGPT} in {Developing} {Language} {Teachers}' {Awareness} and {Pedagogical} {Practices}},
	volume = {11},
	issn = {2411-7390},
	doi = {10.17323/jle.2025.27858},
	abstract = {Background: The field of language education is experiencing substantial advancements with the introduction of Generative Artificial Intelligence (GenAI). While there is a significant amount of research on teachers' perceptions in language education, there is a noticeable gap in understanding the integration of ChatGPT into this field. Purpose: This study investigated the perceptions of EFL teachers in Iran regarding how ChatGPT can contribute to the enhancement of language teaching practices and pedagogical awareness. Method: A qualitative case study examined teachers' perspectives on using ChatGPT in language education. A Zoom webinar on AI in teaching was conducted for Iranian EFL teachers, using tools like Focusky. From 73 registered teachers, 23 were selected based on {\textgreater}= 2 years' teaching experience and voluntary participation. Data were gathered through focus groups, semi-structured interviews (n=10, in Persian), and reflective essays (n=10) submitted two weeks post-webinar. Inductive thematic analysis was performed using NVivo 12, with rigor ensured via peer debriefing, member checking, cross-case comparison, and 83\% inter-coder agreement. Results: Data analysis revealed that ChatGPT can promote pedagogical awareness (i.e., enhanced professional development opportunities, enhancement of critical thinking skills, and autonomy and confidence) and pedagogical practices (i.e., understanding students' needs and personalizing teaching and content creation and resource development). Conclusion: These findings suggest that ChatGPT can positively impact language teachers without necessarily sacrificing their jobs, which is the dominant concern in the current academic literature.},
	language = {English},
	number = {3},
	journal = {JOURNAL OF LANGUAGE AND EDUCATION},
	publisher = {Natl Research Univ Higher Sch Economics},
	author = {Tafazoli, Dara and McCallum, Lee},
	year = {2025},
	note = {Num Pages: 12
Web of Science ID: WOS:001620388000004},
	keywords = {ChatGPT, EDUCATION, Computer-Assisted Language Learning (CALL), Generative Artificial intelligence (GenAI), pedagogical awareness, pedagogical practices},
	pages = {86--97},
}

@article{okulu_designing_2024,
	address = {Abingdon},
	title = {Designing a course for pre-service science teachers using {ChatGPT}: what {ChatGPT} brings to the table},
	volume = {32},
	issn = {1049-4820, 1744-5191},
	doi = {10.1080/10494820.2024.2322462},
	abstract = {ChatGPT holds significant potential for enhancing learning through integration into education as an advanced chatbot. With the goal of harnessing this potential, our research focused on exploring the utilization of ChatGPT in designing a course plan for pre-service science teachers. We adopted a qualitative research approach and employed ChatGPT as an assistant to create a course plan for classroom assessment in science education. Our conversation to create this plan served as our data source for document analysis. We conducted interpretive analysis for qualitative data. The findings emphasized the benefits of ChatGPT in developing an implementable course plan, delivering adaptable information, and time saving. However, there were limitations to consider. These challenges encompassed issues such as communicating out of ChatGPT and the possibility of miscommunication. Despite these limitations, the research findings clearly demonstrate that ChatGPT is highly effective in developing a course plan. As researchers who have personally experienced the process of creating a course plan using ChatGPT, we believe that its potential needs to be maximally utilized. We suggest its application across different subjects and disciplines to thoroughly examine its strengths and weaknesses in depth.},
	language = {English},
	number = {10},
	journal = {INTERACTIVE LEARNING ENVIRONMENTS},
	publisher = {Routledge Journals, Taylor \& Francis Ltd},
	author = {Okulu, Hasan Zuhtu and Muslu, Nilay},
	month = nov,
	year = {2024},
	note = {Num Pages: 18
Web of Science ID: WOS:001172255200001},
	keywords = {ChatGPT, artificial intelligence, science education, course plan, pre-service science teachers},
	pages = {7450--7467},
}

@article{tang_role_2025,
	address = {Abingdon},
	title = {The role of {AI} and entrepreneurial ecosystem in shaping students' digital entrepreneurship intentions: evidence from a multi-group analysis},
	issn = {0218-8791, 1742-6855},
	doi = {10.1080/02188791.2025.2577334},
	abstract = {With the rapid advancement of artificial intelligence (AI), digital entrepreneurship education is being reshaped. Based on social cognitive theory and entrepreneurial orientation theory, this study builds a multi-level framework connecting external factors, cognitive variables, and behavioural intentions. It explores how perceived AI competencies and the entrepreneurial ecosystem influence college students' digital entrepreneurship intentions through self-efficacy and entrepreneurial orientation. A multi-group analysis compares the effects of ChatGPT and non-ChatGPT entrepreneurial education. Using data from 435 Chinese university students and PLS-SEM analysis, results show that perceived AI competencies boost both self-efficacy and orientation across all groups. The entrepreneurial ecosystem impacts self-efficacy broadly but affects entrepreneurial orientation only in ChatGPT group. The effect differs significantly between ChatGPT and non-ChatGPT groups, while other cognitive paths remain consistent. These findings highlight AI's growing role in education and offer guidance for curriculum design and AI tool integration.},
	language = {English},
	journal = {ASIA PACIFIC JOURNAL OF EDUCATION},
	publisher = {Routledge Journals, Taylor \& Francis Ltd},
	author = {Tang, Ling and Lin, Qiaoling and Luo, Xi and Li, Yingxia and Lu, Manwen},
