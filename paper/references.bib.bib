Web of Science ID: WOS:001356688800007},
	keywords = {LLM, AI, research methods., social science, synthetic data},
	pages = {145--168},
}

@article{blasco-soplon_what_2025,
	address = {Barcelona},
	title = {What does {AI} hide? {Critical} and comparative analysis between {ChatGPT}'s interface and artistic data visualization {Look} into the machine's mind},
	issn = {1695-5951},
	doi = {10.7238/artnodes.v0i35.429364},
	abstract = {For several years, the necessity of examining the impact of the techno-scientific paradigm on culture and society has been approached from various perspectives. The frameworks for study are becoming increasingly interdisciplinary and aim to address the intricate complexities surrounding us, striving to understand the social and material relationships in which we exist. Data visualization and generative AI are two technocultural manifestations that shape realities increasingly influenced by data and algorithms. This work presents an analytical framework for visualizations that seeks to uncover the mechanisms involved in the production and circulation of their interfaces. Considering them as complex artefacts that both represent the world and shape our realities necessitates the integration of diverse perspectives and an examination that questions the discourses that render them possible and the imaginaries they produce. The proposed analytical tool invites a thorough study of the visualization in question and encourages building a reflection that, while it can commence on the visible surface, aims to uncover the underlying gears and tensions that often remain obscured. The model is implemented through a critical and comparative analysis between ChatGPT's interface and the artistic project, Look into the machine's mind, which visualizes ChatGPT outputs.},
	language = {English},
	number = {35},
	journal = {ARTNODES},
	publisher = {Univ Oberta Catalunya},
