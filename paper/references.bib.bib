	keywords = {higher education, ACCEPTANCE, KNOWLEDGE, MODEL, MOTIVATION, TPACK, FRAMEWORK, generative AI (GenAI), EQUATION, ICT, PERSPECTIVE, self-determination theory (SDT), self-efficacy, teachers' willingness},
	pages = {e70328},
}

@article{magrill_preparing_2024,
