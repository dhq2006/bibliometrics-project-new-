	year = {2024},
	note = {Num Pages: 11
Web of Science ID: WOS:001265368400014},
	keywords = {ACCEPTANCE, Academia, ChatGPT usage, Pakistan, Significant predictors, UTAUT model},
	pages = {135--145},
}

@article{tsao_beyond_2024,
