@article{newton_how_2025,
	address = {Abingdon},
	title = {How vulnerable are {UK} universities to cheating with new {GenAI} tools? {A} pragmatic risk assessment},
	volume = {50},
	issn = {0260-2938, 1469-297X},
	doi = {10.1080/02602938.2025.2511794},
	abstract = {There has been considerable speculation about the risk that new generative AI tools like ChatGPT pose to higher education, particularly assessments and cheating. However it is unclear how much risk the UK higher education sector is exposed to. This survey study used a modified list experiment to evaluate that risk. Most students surveyed were using GenAI, and almost all were frequently assessed using methods that are vulnerable to cheating with GenAI (unsupervised online examinations, and essays). An estimated 22\% of them reported cheating in academic year 2023/24 and almost all were confident that they understood the policy of their university. However the activities that they report using GenAI for were not always clearly identifiable as cheating. These findings suggest an urgent need for the use of more appropriate forms of summative assessment in UK higher education, and clarity over the policies and definitions used to support those assessments.},
	language = {English},
	number = {8},
	journal = {ASSESSMENT \& EVALUATION IN HIGHER EDUCATION},
	publisher = {Routledge Journals, Taylor \& Francis Ltd},
	author = {Newton, Philip M.},
	month = nov,
	year = {2025},
	note = {Num Pages: 12
Web of Science ID: WOS:001509582700001},
	keywords = {academic integrity, Artificial intelligence, cheating, assessment validity},
	pages = {1332--1343},
}

@article{tu_trends_2025,
	address = {Geneva},
	title = {Trends of generative {AI} applications in educational settings},
	volume = {19},
	issn = {1746-725X, 1746-7268},
	doi = {10.1504/IJMLO.2025.149024},
	abstract = {With the development and widespread adoption of Generative Artificial Intelligence (GenAI), educational institutions and scholars worldwide have begun exploring the potential contributions and applications of GenAI in education. This study aimed to identify the primary research directions of GenAI in education using keyword co-occurrence analysis, by revealing the commonly used keywords for GenAI application in educational research as well as the correlations between different research topics. The results indicate that current research on GenAI in education primarily focuses on learners' perceptions of using GenAI and literature reviews of GenAI in education research. Over time, studies on the evaluation of the learning effectiveness of GenAI have increased; however, there are still fewer studies on the testing and development of GenAI as a teaching support tool and the application of GenAI as an evaluation and feedback tool. Moreover, there is a notable lack of analysis of the cognitive and behavioural characteristics of learners during the learning process of GenAI. Based on the analysis results, this study provides recommendations for future research within each research category.},
	language = {English},
	number = {4},
	journal = {INTERNATIONAL JOURNAL OF MOBILE LEARNING AND ORGANISATION},
