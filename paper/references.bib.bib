	author = {Kurian, Nomisha},
	month = oct,
	year = {2025},
	note = {Num Pages: 14
Web of Science ID: WOS:001268912000001},
	keywords = {large language models, generative AI, AI and children, child safeguarding, DATAFICATION, DIGITAL DATA, Responsible AI},
	pages = {621--634},
}

