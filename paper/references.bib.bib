}

@article{spitsberg_large_2025,
	address = {Abingdon},
	title = {Large language model {AI}-guided creative writing co-creation in secondary schools},
	volume = {64},
	issn = {0040-5841, 1543-0421},
	doi = {10.1080/00405841.2025.2528551},
	abstract = {Most recent literature on AI/LLM in schools around writing focuses on avoiding plagiarism and academic dishonesty, as opposed to considering how such technologies might be a real classroom resource for both teachers and student writers, a claim supported by recent research. Our proposed adapted model of creative writing intervention highlights the concept of co-creation in the writing domain, which is especially beneficial for middle- and high-school students in the areas of inspiration, creativity, and engagement, countering the unfortunately common belief that the use of AI tends to reduce student creativity. The practices described allow teachers an implementable, defensible, and logistically manageable site for first forays into student/AI co-creation in a space generally not part of high-stakes testing or other high-profile curricular mandates while providing students with a ready and attractive partner in overcoming the blinking cursor, empty page, and sense of themselves as non-creative and/or uninspired.},
