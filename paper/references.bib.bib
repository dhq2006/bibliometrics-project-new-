@article{choemprayong_mapping_2026,
	address = {Oxford},
	title = {Mapping the intersection of digital technologies and humanities: a multidisciplinary scoping review of the digital humanities movement in {Thailand}},
	volume = {41},
	issn = {2055-7671, 2055-768X},
	doi = {10.1093/llc/fqaf117},
	abstract = {Although digital humanities (DH) lacks a universally accepted definition, its boundaries are often shaped by local contexts and cultural factors. In Thailand, no formal DH programs exist, and only a few publications explicitly address the term "digital humanities". At the same time, it is speculated that works considered as DH research have been sporadically produced. To gain a nuanced understanding of the Thai DH landscape, this study conducted a scoping review of scholarly works published between 2010 and 2019, using broad operational definitions and frameworks, and integrating quantitative and qualitative analyses. We identified a wide range of publications, frequently anchored in computer science and related fields, yet also involving humanities scholars and emerging "born-digital" disciplines. Many works focus on applying or developing digital tools, while relatively few emphasize long-term data stewardship or critical humanities-oriented methods. Patterns of collaboration remain mostly within or across departments, and conference proceedings dominate as publication venues, reflecting scholarly communication practices of Thai DH scholars. These findings suggest that a DH movement exists in Thailand without formal institutionalization or a cohesive community. By mapping the field's scope and boundaries before the widespread adoption of generative AI, this study provides baseline evidence that can inform future strategies, encourage interdisciplinary dialogue, and situate Thai DH research within a broader international context.},
	language = {English},
	number = {1},
	journal = {DIGITAL SCHOLARSHIP IN THE HUMANITIES},
	publisher = {Oxford Univ Press},
	author = {Choemprayong, Songphan and Chintakovid, Thippaya and Arsa, Papatsara and Intaranuch, Kongweha and Lohakit, Phim-on and Mongkolsriniyom, Weerakamol and Tapanakulsak, Theerathorn},
	month = apr,
	year = {2026},
	note = {Num Pages: 18
Web of Science ID: WOS:001595533100001},
	keywords = {digital humanities, interdisciplinary research, scoping review, Thailand},
	pages = {51--68},
}

