	pages = {17965--17985},
}

@article{du_doctoral_2025,
	address = {London},
	title = {Doctoral students' use of {Generative} {AI} and their engagement in {English} for {Research} {Publication} {Purposes} writing: {An} activity theory perspective},
	volume = {134},
	issn = {0346-251X, 1879-3282},
	doi = {10.1016/j.system.2025.103828},
	abstract = {Drawing on Activity Theory, the present study adopted a multiple-case design to investigate three Chinese doctoral students' use of Generative AI (GenAI) in their English for Research Publication Purposes (ERPP) writing. Data including GenAI dialogue histories, semi-structured interviews, drafts and revised versions, and reflective journals were coded following the thematic analysis procedure. The results revealed: (1) the three participants used GenAI for language-related, content-related, and format-related purposes; (2) the use of GenAI could be attributed to three contradictions: division of labor vs. subject, community vs. subject, and rule vs. subject; (3) GenAI use resolved the three contradictions, but generated two new contradictions: rule vs. subject and division of labor vs. subject. The resolution of old contradictions and the addition of new contradictions exerted idiosyncratic impacts on three doctoral students' behavioral, emotional, and cognitive (dis)engagement in ERPP writing. The present study extends the applicability of Activity Theory to a GenAI-mediated L2 writing context and reveals the complex relationship between GenAI use and sub-dimensions of GenAI-mediated writing engagement.},
	language = {English},
	journal = {SYSTEM},
	publisher = {Elsevier Sci Ltd},
	author = {Du, Chenxi and Yang, Yingli},
	month = nov,
	year = {2025},
	note = {Num Pages: 16
Web of Science ID: WOS:001565443500001},
	keywords = {Generative AI, writing, SCHOOL, Doctoral students, Activity theory, AUTOMATED FEEDBACK, CHINESE, English for Research Publication Purposes, Multi-case study, Writing engagement},
	pages = {103828},
}

