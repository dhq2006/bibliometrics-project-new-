	title = {All {Assignments} {Are} {Equal}, but {Some} {Assignments} {Are} {More} {Equal} {Than} {Others}: {Exploring} {Student} {Responses} to {AI} and {Peer}-{Generated} {Alternative} {Endings} in {Orwell}'s {Animal} {Farm}},
