Web of Science ID: WOS:001392823100001},
	keywords = {ARTIFICIAL-INTELLIGENCE, MATHEMATICS, Generative AI in education, AI-assisted instruction, learning by teaching, Students' perceptions, teachable agent},
	pages = {535--554},
}

@article{song_elementary_2026,
	address = {Abingdon},
	title = {Elementary school students' and teachers' perceptions toward creative mathematical writing with {Generative} {AI}},
	volume = {58},
	issn = {1539-1523, 1945-0818},
	doi = {10.1080/15391523.2025.2455057},
	abstract = {While mathematical creative writing can engage students in expressing mathematical ideas in an imaginative way, young learners struggle in this process. Generative AI (GenAI) offers possibilities for supporting them, such as providing story generation. As the design of GenAI-powered learning technologies requires careful consideration of the technology reception in classrooms, this study explores students' and teachers' perceptions of creative mathematical writing with the developed GenAI-powered technology. We adopted a qualitative thematic analysis of the interviews with 10 elementary school students and six teachers, triangulated with open-ended survey responses and classroom observation of 79 students. We identified six themes and 19 subthemes regarding benefits and challenges; perceived benefits include fostering creativity and understanding in math, AI literacy, and affective domain, while students- and AI-related challenges were identified as well. This study contributes by investigating the lived experience of GenAI-supported learning and the design considerations for GenAI-powered learning technologies and instructions.},
	language = {English},
	number = {3},
	journal = {JOURNAL OF RESEARCH ON TECHNOLOGY IN EDUCATION},
	publisher = {Routledge Journals, Taylor \& Francis Ltd},
	author = {Song, Yukyeong and Kim, Jinhee and Xing, Wanli and Liu, Zifeng and Li, Chenglu and Oh, Hyunju},
	month = may,
	year = {2026},
	note = {Num Pages: 23
Web of Science ID: WOS:001411789900001},
	keywords = {Generative AI in education, AI-supported math learning, mathematical creative writing, student perception, teacher perception},
	pages = {615--637},
}

@article{ferreira_creative_2025,
