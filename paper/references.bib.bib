	pages = {166--187},
}

@article{da_costa_who_2023,
	address = {Inhumas},
	title = {{WHO} {IS} {AFRAID} {OF} {CHATGPT}? {REFLECTIONS} {ON} {THE} {IMPACTS} {OF} {NEW} {AIS} {ON} {SOCIAL} {LIFE} {AND} {IN} {ACADEMIA}},
