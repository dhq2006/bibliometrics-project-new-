Web of Science ID: WOS:001197300400001},
	keywords = {ChatGPT, Artificial intelligence, Structural equation model, ADOPTION, INFORMATION-TECHNOLOGY, USER ACCEPTANCE, MODEL, Education digitization, Latent class model},
