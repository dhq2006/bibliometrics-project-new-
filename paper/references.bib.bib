}

@article{abadal_ensuring_2024,
	address = {Charlottesville},
	title = {Ensuring {Genuine} {Assessment} in {Philosophy} {Education}: {Strategies} for {Scaffolding} {Writing} {Assessment} in an {LLM} {Era}},
	volume = {47},
	issn = {0145-5788, 2153-6619},
	doi = {10.5840/teachphil2024422195},
	abstract = {In this article, I will outline an assessment model that allows instructors to continuing assigning term papers and argumentative papers without compromising the authenticity of student assessment. This path forward relies upon a pseudo flipped classroom model in which students will complete a scaffolded term paper through a series of in -class assessments that build upon previously completed components. The final steps of completing this assignment will require producing a draft and final version of a traditional term paper outside of the classroom but only after the instructor ensures they have critically thought through the preceding components independently. The intention is to maintain the nuance, critical thinking, engagement with primary and secondary sources, and depth of content comprehension that a thoughtful paper requires, while also ensuring that students are completing the work themselves and not merely outsourcing bits and pieces of it to LLMs.},
