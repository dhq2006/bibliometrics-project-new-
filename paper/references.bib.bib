Web of Science ID: WOS:001462076400001},
	keywords = {ChatGPT, prompt engineering, CONTENT KNOWLEDGE, THINKING, INSTRUCTIONAL TASKS, mathematics teacher educator, task design, technological pedagogical and content knowledge},
