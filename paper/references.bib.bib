Web of Science ID: WOS:001508517100001},
	keywords = {ChatGPT, DESIGN, KNOWLEDGE, STUDENTS, COMPETENCE, FEEDBACK, Epistemic network analysis, Lesson plan critiques, Lesson planning skills, PEER ASSESSMENT, Pre-service teacher education, QUESTION PROMPTS},
	pages = {101022},
}

