	note = {Num Pages: 12
Web of Science ID: WOS:001636401100011},
	keywords = {Generative AI, CULTURAL-HERITAGE, Virtual reality, AI-Based virtual assistants, Cultural heritage, Immersive education, WILL},
	pages = {100112},
}

