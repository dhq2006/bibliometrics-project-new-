Web of Science ID: WOS:001503001300001},
	keywords = {Artificial intelligence, DESIGN, OPPORTUNITIES, ADVANTAGES, AUGMENTED REALITY, Designing learning spaces, Digital transformation, Emerging learning spaces, ENVIRONMENTS, Future learning spaces, PREFERENCES, RESOURCES, STUDIO},
