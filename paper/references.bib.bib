	note = {Num Pages: 15
Web of Science ID: WOS:001615243000010},
	keywords = {Artificial Intelligence, Artificial Creativity, Environmental Education, Environmental Problem Solving, Human Creativity},
	pages = {496--510},
}

@article{lv_good_2025,
	address = {Oxford},
	title = {Good deeds deserve good outcomes: {Leveraging} generative artificial intelligence to reduce tourists' avoidance of ethical brands embracing stigmatized groups},
